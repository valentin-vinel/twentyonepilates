---
import { studio } from '../config/studio';
import { fill, titleHtml } from '../lib/text';
import BookingCta from './BookingCta.astro';
import Photo from './Photo.astro';

const { title, text, storefront, photos } = studio.sections.final;
---

<section class="final" id="reserver" aria-labelledby="final-titre">
  <div class="wrap final__inner">
    <div>
      <h2 class="display final__title" id="final-titre" set:html={titleHtml(title)} />
      {text && <p class="final__text">{fill(text)}</p>}
    </div>

    <div class="final__body">
      <BookingCta class="final__booking" />

      {(storefront || photos.length > 0) && (
        <div class:list={['final__visit', photos.length === 0 && 'final__visit--single']}>
          {storefront && (
            <Photo
              photo={storefront}
              class="final__storefront"
              widths={[400, 640, 960, 1200, 1600]}
              // Photo recadrée pour remplir sa case : la largeur affichée de
              // l'image peut dépasser celle de la case.
              sizes={photos.length === 0
                ? '(min-width: 860px) 830px, calc(100vw - 2.5rem)'
                : '(min-width: 860px) 600px, calc(100vw - 2.5rem)'}
            />
          )}
          {photos.map((photo) => (
            <Photo
              photo={photo}
              class="final__square"
              widths={[200, 400, 600]}
              sizes="(min-width: 860px) 240px, calc(50vw - 1.5rem)"
            />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
