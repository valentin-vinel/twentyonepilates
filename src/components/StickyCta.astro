---
import { studio } from '../config/studio';
import { fill } from '../lib/text';
import CtaButton from './CtaButton.astro';

/**
 * Appel à l'action fixe. Mobile : barre pleine largeur. Ordinateur : bulle en
 * bas à droite, qui déplie le libellé au survol ou au focus.
 * Même cible et même libellé que les autres boutons : la réservation Momence
 * (suivi du clic dans CtaButton.astro, via data-booking).
 */
---

<div class="mobilebar" data-sticky data-visible="false">
  <CtaButton class="mobilebar__btn" />
</div>

<a class="bubble" data-sticky data-visible="false" href={studio.cta.url} data-booking>
  <span class="bubble__label">{fill(studio.cta.label)}</span>
  <!-- Calendrier : la bulle mène au choix d'un créneau. -->
  <svg class="bubble__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
    <rect x="3" y="4" width="18" height="18" rx="2" />
    <path d="M16 2v4M8 2v4M3 10h18" />
  </svg>
</a>

<script>
  // Masqués tant que le hero est à l'écran (son bouton suffit), puis affichés
  // en continu dès qu'il est passé, sans clignoter d'une section à l'autre.
  // Masqués à nouveau sur le bloc final (#reserver), qui a son propre bouton,
  // et si l'on remonte jusqu'au hero.
  const stickies = document.querySelectorAll<HTMLElement>('[data-sticky]');
  const hero = document.getElementById('hero');
  const final = document.getElementById('reserver');

  if (stickies.length && hero) {
    let heroPassed = false;
    let finalOnScreen = false;
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) heroPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        else finalOnScreen = entry.isIntersecting;
      }
      const visible = String(heroPassed && !finalOnScreen);
      stickies.forEach((el) => (el.dataset.visible = visible));
    });
    observer.observe(hero);
    if (final) observer.observe(final);
  }
</script>
