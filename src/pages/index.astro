---
import Landing from '../layouts/Landing.astro';
import { brand } from '../config/brand';
import { studio } from '../config/studio';
import { placeholders } from '../lib/placeholders';
import { fill } from '../lib/text';
import Hero from '../components/Hero.astro';
import Reassurance from '../components/Reassurance.astro';
import Discovery from '../components/Discovery.astro';
import StudioSection from '../components/StudioSection.astro';
import SessionSteps from '../components/SessionSteps.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Team from '../components/Team.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';

// Garde-fous de build : rien n'arrête la construction, tout se voit dans la console.
if (studio.reviews.some((review) => review.placeholder)) {
  console.warn('\n⚠  Des avis d’exemple (placeholder: true) sont encore affichés.\n');
}
if (studio.faq.some((item) => /\[.*\]/.test(item.answer))) {
  console.warn('\n⚠  Des réponses de la FAQ sont encore entre crochets : à faire valider par le studio.\n');
}
const todo = [
  ...placeholders(studio).map((path) => `studio.${path}`),
  ...placeholders(brand).map((path) => `brand.${path}`),
];
if (todo.length > 0) {
  console.warn(`\n⚠  ${todo.length} placeholders entre crochets à remplir :\n   ${todo.join('\n   ')}\n`);
}
---

<Landing title={fill(studio.meta.title)} description={fill(studio.meta.description)} noindex>
  <main>
    <Hero />
    <Reassurance />
    <Discovery />
    <StudioSection />
    <SessionSteps />
    <Reviews />
    <!-- <Team /> -->
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyCta />
</Landing>
