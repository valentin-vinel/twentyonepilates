---
import { brand } from '../config/brand';
import { studio } from '../config/studio';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ConsentBanner from '../components/ConsentBanner.astro';
import MetaPixel from '../components/MetaPixel.astro';
import { resolvePhoto } from '../lib/media';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;

// Aperçu de partage : les réseaux sociaux exigent une URL absolue, donc siteUrl.
const ogSource = studio.meta.image && resolvePhoto(studio.meta.image);
if (ogSource && !studio.siteUrl) {
  console.warn('\n⚠  meta.image renseigné mais siteUrl vide : aucune og:image.\n');
}
const ogImage =
  ogSource && studio.siteUrl
    ? await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
    : undefined;

const { colors, fonts, easing, fontFaces } = brand;
// Polices servies en local depuis public/fonts/ (licences OFL à côté des fichiers).
const fontFaceCss = fontFaces
  .map(
    (face) =>
      `@font-face{font-family:"${face.family}";src:url('/fonts/${face.file}') format('woff2');` +
      `font-weight:${face.weight};font-style:${face.style};font-display:swap}`,
  )
  .join('\n');
const preloadFont = fontFaces.find((face) => face.preload);

// Chaque token de brand.ts devient une variable CSS : bgAlt → --c-bg-alt.
const kebab = (key: string) => key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
const vars = (prefix: string, group: Record<string, string>) =>
  Object.entries(group).map(([key, value]) => `  --${prefix}-${kebab(key)}:${value};`);
const rootVars = `${fontFaceCss}
:root{
${[
  ...vars('c', colors),
  ...vars('f', fonts),
  ...vars('ease', easing),
  `  --radius:${brand.radius};`,
  `  --max-w:${brand.maxWidth};`,
].join('\n')}
}`;
---

<!doctype html>
<html lang="fr" data-theme={brand.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={studio.name} />
    {studio.siteUrl && <meta property="og:url" content={new URL(Astro.url.pathname, studio.siteUrl).href} />}
    {ogImage && (
      <>
        <meta property="og:image" content={new URL(ogImage.src, studio.siteUrl).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={studio.meta.image!.alt} />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {studio.siteUrl && <link rel="canonical" href={new URL(Astro.url.pathname, studio.siteUrl).href} />}
    {preloadFont && <link rel="preload" as="font" type="font/woff2" crossorigin href={`/fonts/${preloadFont.file}`} />}
    <style is:global set:html={rootVars}></style>
    <MetaPixel />
  </head>
  <body>
    <slot />
    <ConsentBanner />

    <script>
      // Capture des identifiants de campagne à l'arrivée.
      // Aucune donnée personnelle : uniquement des identifiants techniques.
      const KEYS = ['fbclid', 'utm_source', 'utm_campaign', 'utm_content'];
      try {
        const params = new URLSearchParams(window.location.search);
        for (const key of KEYS) {
          const value = params.get(key);
          if (value && !sessionStorage.getItem(key)) sessionStorage.setItem(key, value);
        }
      } catch {
        // sessionStorage indisponible (navigation privée stricte) : on continue sans.
      }
    </script>
  </body>
</html>
